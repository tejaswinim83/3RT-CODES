def process_replay_file(filepath):
    """
    Reads data line by line from CSV and pushes packets that match
    RT headers into the data_queue — exactly how live serial data is handled.
    """
    global replay_running, replay_paused, jump_target_sec, selected_tab

    # 1️⃣ Pick correct header based on active tab (RT1, RT2, RT3)
    headers = RT_HEADERS[selected_tab]
    main_header = headers[0].upper()
    secondary_header = headers[1].upper() if len(headers) > 1 else None

    print(f"🎯 Using headers for {selected_tab}: MAIN={main_header}, SECONDARY={secondary_header}")

    try:
        with open(filepath, "r", encoding="utf-8") as f:
            reader = csv.reader(f)
            next(reader, None)  # Skip CSV column header row if present
            fast_skip_mode = jump_target_sec is not None
            line_no = 0

            for row in reader:
                # 2️⃣ Stop if user pressed "Stop Replay"
                if not replay_running:
                    break
                line_no += 1

                # 3️⃣ Ensure row has data
                if len(row) < 2:
                    print(f"⚠️ Line {line_no}: skipped (not enough columns)")
                    continue

                # 4️⃣ Normalize hex string (remove spaces, 0x, commas)
                raw_hex = row[1].upper().replace(" ", "").replace("0X", "").replace(",", "")

                # 5️⃣ Extract SYS_Second for jump logic
                try:
                    # Adjust indices here if SYS_Second location changes in your packet
                    SYS_Second_hex = row[1][148:156].replace(" ", "")
                    SYS_Second_val = int(reverse_and_concatenate(SYS_Second_hex), 16)
                except Exception as e:
                    print(f"⚠️ Line {line_no}: SYS_Second parse failed ({e})")
                    continue

                # 6️⃣ Jump handling: skip lines until we reach target SYS_Second
                if jump_target_sec is not None:
                    if SYS_Second_val < jump_target_sec:
                        continue
                    elif SYS_Second_val > jump_target_sec:
                        print(f"✅ Jumped! Starting from SYS_Second={SYS_Second_val}")
                        jump_target_sec = None
                        fast_skip_mode = False

                # 7️⃣ Header match check
                if raw_hex.startswith(main_header):
                    data_queue.put(("header1", row[1]))
                    print(f"[Line {line_no}] ✅ MAIN header match @ SYS_Second={SYS_Second_val}")
                elif secondary_header and raw_hex.startswith(secondary_header):
                    data_queue.put(("header2", row[1]))
                    print(f"[Line {line_no}] ✅ SECONDARY header match @ SYS_Second={SYS_Second_val}")
                else:
                    if line_no < 10:
                        print(f"[Line {line_no}] ❌ NO MATCH startswith='{raw_hex[:16]}'")

                # 8️⃣ Pause handling — waits if user has paused replay
                while replay_paused and replay_running:
                    pytime.sleep(0.2)

                # 9️⃣ Control replay speed (0.5s between packets normally)
                if not fast_skip_mode:
                    pytime.sleep(0.5)

        print("✅ Replay finished or stopped.")

    except UnicodeDecodeError:
        print("❌ File encoding error! Try saving your CSV as UTF-8.")


