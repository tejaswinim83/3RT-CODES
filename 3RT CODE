def reverse_and_concatenate(hex_str):
    """
    Takes a hex string like '12 34 56 78' and returns reversed order '78563412'.
    Useful for SYS_Second word extraction where endianness matters.
    """
    hex_str = hex_str.replace(" ", "")
    bytes_list = [hex_str[i:i+2] for i in range(0, len(hex_str), 2)]
    reversed_bytes = bytes_list[::-1]
    return ''.join(reversed_bytes)


