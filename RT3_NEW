# ==================== FILE SAVING FUNCTIONS ====================
def get_timestamped_filename(base_name: str, suffix: str, rt_name: str = "") -> str:
    """
    Generate consistent file name in format:
    GAGANYAN_YYYY-MM-DD_HH-MM-SS_RTNAME_BASENAME_SUFFIX.csv
    """
    if rt_name:
        return f"GAGANYAN_{SESSION_TIMESTAMP}_{rt_name}_{base_name}_{suffix}.csv"
    else:
        return f"GAGANYAN_{SESSION_TIMESTAMP}_{base_name}_{suffix}.csv"


def write_to_raw_1200(data, base_name, rt_name="RT1"):
    file_name = get_timestamped_filename(base_name, "Raw_1200", rt_name)
    header = ['TimeStamp', 'RT', 'PacketType', 'RAW_DATA_1200']
    
    with open(file_name, mode='a', newline='') as file:
        writer = csv.writer(file)
        if file.tell() == 0:
            writer.writerow(header)
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
        writer.writerow([timestamp, rt_name, "1200_BYTE", data])


