# ==================== DATA PROCESSING FUNCTIONS ====================
def reverse_and_concatenate(hex_list, scale=1, is_signed=False):
    if len(hex_list) in [1, 2, 3, 4, 8]:
        if len(hex_list) == 1:
            concatenated_hex = ''.join(hex_list)
            decimal_value = int(concatenated_hex, 16)
        elif len(hex_list) == 2:
            concatenated_hex = ''.join(hex_list)
            decimal_value = int(concatenated_hex, 16)
        elif len(hex_list) == 3:
            concatenated_hex = ''.join(hex_list)
            decimal_value = int(concatenated_hex, 16)
        elif len(hex_list) == 4:
            first_half = ''.join(hex_list[:2])
            second_half = ''.join(hex_list[2:])
            concatenated_hex = second_half + first_half
            decimal_value = int(concatenated_hex, 16)
        elif len(hex_list) == 8:
            first_half = ''.join(hex_list[:4])
            second_half = ''.join(hex_list[4:])
            reversed_first_half = first_half[6:8] + first_half[4:6] + first_half[2:4] + first_half[0:2]
            reversed_second_half = second_half[6:8] + second_half[4:6] + second_half[2:4] + second_half[0:2]
            concatenated_hex = reversed_first_half + reversed_second_half
            decimal_value = int(concatenated_hex, 16)

        if is_signed:
            if decimal_value >= 0x80000000:
                decimal_value -= 0x100000000

        return decimal_value
    return None


def convert_to_decimal(hex_str):
    reversed_hex = ''.join([hex_str[i:i+2] for i in range(0, len(hex_str), 2)][::-1])
    return int(reversed_hex, 16)


def decode_channel_status_meaning(status_word):
    bits = [(status_word >> i) & 1 for i in range(16)]
    T = "T" if bits[0] else "NT"
    S = "S" if bits[1] else "NS"
    antenna_bits = (bits[9] << 1) | bits[8]
    antenna_map = {
        0b00: "1",
        0b01: "2",
        0b10: "3",
        0b11: "4",
    }
    
    return {
        "T": f"{T}/{S}",
        "E": "Y" if bits[2] else "N",
        "P": "Y" if bits[3] else "N",
        "I": "Y" if bits[4] else "N",
        "S": "Y" if bits[5] else "N",
        "P1": "P" if bits[6] else "R",
        "H": "G" if bits[7] else "B",
        "A": antenna_map.get(antenna_bits, "UK"),
        "SR": "P" if bits[10] else "R",
        "R": "P" if bits[11] else "R",
        "E1": "Y" if bits[12] else "N",
        "D": "Y" if bits[14] else "N",
    }


def extract_word20_flags(word20):
    sbasen_map = {0b00: "DISABLE", 0b01: "ENABLE"}
    sys_mode_map = {0b01: "GPS", 0b10: "NAVIC", 0b11: "GPS+NAVIC"}
    rec_mode_map = {0b01: "GPS", 0b10: "NAVIC", 0b11: "GPS+NAVIC"}
    time_mode_map = {0b00: "NOT AV", 0b01: "GPS", 0b10: "NAVIC"}
    alm_av_map = {0b00: "ALM AV", 0b01: "ALM NOT AV"}
    time_av_map = {0b00: "TIME NOT AV", 0b01: "TIME AV"}
    pose_mode_map = {0b00: "3D", 0b01: "01-2D", 0b10: "NOT AV"}
    pose_av_map = {0b00: "POS NOT AV", 0b01: "POS AV"}

    tm_sel_val = (word20 >> 15) & 0x1
    swdt_val = (word20 >> 14) & 0x1
    hwdt_val = (word20 >> 13) & 0x1
    sbasen_val = (word20 >> 12) & 0x1
    system_mode_val = (word20 >> 10) & 0x3
    rec_mode_val = (word20 >> 8) & 0x3
    time_mode_val = (word20 >> 6) & 0x3
    alm_av_val = (word20 >> 4) & 0x3
    time_av_val = (word20 >> 3) & 0x1
    pose_mode_val = (word20 >> 1) & 0x3
    pos_av_val = word20 & 0x1

    return {
        "Tm_sel": tm_sel_val,
        "SWDT": swdt_val,
        "HWDT": hwdt_val,
        "SBASEN": sbasen_map.get(sbasen_val, str(sbasen_val)),
        "System_mode": sys_mode_map.get(system_mode_val, str(system_mode_val)),
        "Rec_Mode": rec_mode_map.get(rec_mode_val, str(rec_mode_val)),
        "Time_Mode": time_mode_map.get(time_mode_val, str(time_mode_val)),
        "Alm_Av": alm_av_map.get(alm_av_val, str(alm_av_val)),
        "Time_Av": time_av_map.get(time_av_val, str(time_av_val)),
        "Pose_Mode": pose_mode_map.get(pose_mode_val, str(pose_mode_val)),
        "Pos_Av": pose_av_map.get(pos_av_val, str(pos_av_val)),
    }


# ==================== SERIAL COMMUNICATION FUNCTIONS ====================
def readSerial():
    global serialData, ser
    headers = {
        "RT1_1200": ["ac", "ca", "1f", "0a"],
        "RT1_64": ["ac", "ca", "1f", "0b"],
        "RT2_1200": ["ac", "ca", "1f", "0c"],
        "RT2_64": ["ac", "ca", "1f", "0d"],
        "RT3_1200": ["ac", "ca", "1f", "0e"],
        "RT3_64": ["ac", "ca", "1f", "0f"],
    }
    
    header_indices = {key: 0 for key in headers.keys()}
    
    try:
        while serialData:
            if ser.in_waiting > 0:
                byte = ser.read(1).hex()
                
                for header_name, header_bytes in headers.items():
                    if byte == header_bytes[header_indices[header_name]]:
                        header_indices[header_name] += 1
                        if header_indices[header_name] == len(header_bytes):
                            packet_type = "1200" if header_name.endswith("1200") else "64"
                            rt_name = header_name[:3]
                            
                            if packet_type == "1200":
                                data_length = 1200
                            else:
                                data_length = 64
                            
                            hexDecodedData = ''.join(header_bytes) + ser.read(data_length).hex()
                            data_queue.put((rt_name, packet_type, hexDecodedData))
                            
                            if rt_name == "RT1":
                                global counter_value
                                counter_value += 1
                            elif rt_name == "RT2":
                                global counter_value2
                                counter_value2 += 1
                            elif rt_name == "RT3":
                                global counter_value3
                                counter_value3 += 1
                            
                            header_indices[header_name] = 0
                    else:
                        if byte == "ac":
                            header_indices[header_name] = 1
                        else:
                            header_indices[header_name] = 0
            
            time.sleep(0.001)
                        
    except KeyboardInterrupt:
        print("Reading from serial port stopped")


def process_data():
    try:
        while True:
            item = data_queue.get()
            if not item:
                continue
            
            rt_name, packet_type, hexDecodedData = item
            
            if packet_type == "1200":
                process_1200_packet(hexDecodedData, rt_name)
            else:
                process_64_packet(hexDecodedData, rt_name)
                
    except Exception as e:
        print(f"Error processing data: {e}")


def process_1200_packet(hexDecodedData, rt_name):
    """Process 1200-byte main telemetry packet"""
    print(f"Processing 1200-byte packet for {rt_name}")
    write_to_raw_1200(hexDecodedData, "TELEMETRY", rt_name)
    
    # Get widget references
    if rt_name == "RT1":
        widgets = rt1_widgets
        current_counter = counter_value
    elif rt_name == "RT2":
        widgets = rt2_widgets
        current_counter = counter_value2
    elif rt_name == "RT3":
        widgets = rt3_widgets
        current_counter = counter_value3
    
    try:
        # Extract system time
        SYS_NanoSecond_hex = hexDecodedData[140:148]
        SYS_Second_hex = hexDecodedData[148:156]
        SYS_Weeknumber_hex = hexDecodedData[156:160]
        
        SYS_Second = reverse_and_concatenate(SYS_Second_hex)
        SYS_NanoSecond = reverse_and_concatenate(SYS_NanoSecond_hex)
        SYS_WeekNumber = reverse_and_concatenate(SYS_Weeknumber_hex)
        
        # Save system time
        sys_data = [str(SYS_Second), str(SYS_NanoSecond), str(SYS_WeekNumber)]
        write_to_SYS(sys_data, "TIME", rt_name)
        
        # Update widgets
        if 'time_entry' in widgets:
            widgets['time_entry'].config(state="normal")
            widgets['time_entry'].delete(0, END)
            widgets['time_entry'].insert(0, str(SYS_Second))
            widgets['time_entry'].config(state="readonly")
            
        if 'nanotime_entry' in widgets:
            widgets['nanotime_entry'].config(state="normal")
            widgets['nanotime_entry'].delete(0, END)
            widgets['nanotime_entry'].insert(0, str(SYS_NanoSecond))
            widgets['nanotime_entry'].config(state="readonly")
            
        if 'week_entry' in widgets:
            widgets['week_entry'].config(state="normal")
            widgets['week_entry'].delete(0, END)
            widgets['week_entry'].insert(0, str(SYS_WeekNumber))
            widgets['week_entry'].config(state="readonly")
        
        # Update counter display
        if 'counter_entry' in widgets:
            widgets['counter_entry'].config(state="normal")
            widgets['counter_entry'].delete(0, END)
            widgets['counter_entry'].insert(0, str(current_counter))
            widgets['counter_entry'].config(state="readonly")
        
        # Write summary
        write_rt_summary(rt_name, current_counter, "ACTIVE")
        
    except Exception as e:
        print(f"Error processing 1200-byte packet for {rt_name}: {e}")


def process_64_packet(hexDecodedData, rt_name):
    """Process 64-byte sync/status packet"""
    print(f"Processing 64-byte packet for {rt_name}")
    write_to_raw_64(hexDecodedData, "SYNC", rt_name)
    
    # Get widget references
    if rt_name == "RT1":
        widgets = rt1_widgets
    elif rt_name == "RT2":
        widgets = rt2_widgets
    elif rt_name == "RT3":
        widgets = rt3_widgets
    
    try:
        if len(hexDecodedData) >= 40:
            SYN_NanoSecond_hex = hexDecodedData[12:20]
            SYN_Second_hex = hexDecodedData[20:28]
            SYN_Weeknumber_hex = hexDecodedData[28:32]
            
            SYN_Second = reverse_and_concatenate(SYN_Second_hex)
            SYN_NanoSecond = reverse_and_concatenate(SYN_NanoSecond_hex)
            SYN_WeekNumber = reverse_and_concatenate(SYN_Weeknumber_hex)
            
            # Save sync time
            syn_data = [str(SYN_Second), str(SYN_NanoSecond), str(SYN_WeekNumber)]
            write_to_SYN(syn_data, "SYNC_TIME", rt_name)
            
            # Update widgets
            if 'time_entry1' in widgets:
                widgets['time_entry1'].config(state="normal")
                widgets['time_entry1'].delete(0, END)
                widgets['time_entry1'].insert(0, str(SYN_Second))
                widgets['time_entry1'].config(state="readonly")
                
            if 'nanotime_entry1' in widgets:
                widgets['nanotime_entry1'].config(state="normal")
                widgets['nanotime_entry1'].delete(0, END)
                widgets['nanotime_entry1'].insert(0, str(SYN_NanoSecond))
                widgets['nanotime_entry1'].config(state="readonly")
                
            if 'week_entry1' in widgets:
                widgets['week_entry1'].config(state="normal")
                widgets['week_entry1'].delete(0, END)
                widgets['week_entry1'].insert(0, str(SYN_WeekNumber))
                widgets['week_entry1'].config(state="readonly")
        
    except Exception as e:
        print(f"Error processing 64-byte packet for {rt_name}: {e}")


